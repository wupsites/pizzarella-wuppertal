# Öffentliche Adresse der Website (für Canonicals, Sitemap, OpenGraph)
SITE_URL=https://pizzarella-wuppertal.de

# ── Bestell-Zustellung ────────────────────────────────────────────────
# Mindestens EIN Kanal muss in Produktion konfiguriert sein, sonst zeigt die
# Kasse ehrlich „Online-Bestellung gerade nicht möglich – bitte anrufen“.

# 1) E-Mail via SMTP (empfohlen): jede Bestellung als Bon an den Laden
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ORDER_MAIL_FROM="Pizzarella Website <bestellung@pizzarella-wuppertal.de>"
ORDER_MAIL_TO=
# Kopie an Kund:innen schicken, wenn sie eine E-Mail angeben (true/false)
ORDER_MAIL_CUSTOMER_COPY=true

# 2) Webhook (z. B. Bon-Drucker-Dienst, n8n, Telegram-Bot): POST mit JSON
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=

# Nur Entwicklung/Test: Bestellungen in ./.orders/ ablegen statt versenden
ORDER_DEV_SINK=false
