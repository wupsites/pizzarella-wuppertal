{
  "name": "pizzarella-wuppertal",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Website und Online-Bestellung für Pizzarella, Friedrich-Engels-Allee 117, 42285 Wuppertal",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run data:check && astro build",
    "preview": "node ./dist/server/entry.mjs",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "data:check": "node --experimental-strip-types scripts/data-report.ts",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "qa": "node scripts/qa/run.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.6",
    "gsap": "^3.15.0",
    "lenis": "^1.1.20",
    "nodemailer": "^10.0.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
