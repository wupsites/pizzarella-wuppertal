---
import Base from '../layouts/Base.astro';
import Dish from '../components/Dish.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/index.ts';
import { hoursCompact } from '../lib/hours.ts';
import { formatEuro } from '../lib/pricing.ts';
import { menuJsonLd, breadcrumbJsonLd } from '../lib/seo.ts';

const { catalog, ordering } = site;
const cats = catalog.visibleCategories;
const total = cats.reduce((n, c) => n + c.products.length, 0);
const pizzaFrom = cats.find((c) => c.id === 'pizza')?.fromPrice ?? null;
const siteUrl = (Astro.site?.href ?? 'https://pizzarella-wuppertal.de/').replace(/\/?$/, '/');
const pickup = ordering.modes.pickup.enabled && ordering.modes.delivery.enabled;
---

<Base
  title="Speisekarte: Pizza, Döner & Lahmacun bestellen – Pizzarella Wuppertal"
  description={`Die komplette Karte von Pizzarella in Wuppertal: ${total} Gerichte – Pizza ab ${pizzaFrom ? formatEuro(pizzaFrom) : ''}, Döner, Lahmacun, Falafel, Pasta, Salate. Online bestellen, liefern lassen oder abholen.`}
  current="speisekarte"
  bodyClass="page-menu"
  jsonLd={[menuJsonLd(site, siteUrl), breadcrumbJsonLd(siteUrl, [{ name: 'Start', path: '/' }, { name: 'Speisekarte', path: '/speisekarte/' }])]}
>
  <section class="menu-head wrap">
    <div class="mh-text">
      <p class="label">Speisekarte · Friedrich-Engels-Allee 117</p>
      <h1 class="d1">Die ganze Karte.</h1>
      <p class="mh-sub">
        <span><span class="num">{total}</span> Gerichte{pizzaFrom && <> · Pizza ab <span class="num">{formatEuro(pizzaFrom)}</span></>}</span>
        <span class="mh-status"><span class="dot" aria-hidden="true"></span><span data-status-line>{hoursCompact(site.business.hours)}</span></span>
      </p>
    </div>
    {
      pickup && (
        <div class="segmented mh-mode" role="radiogroup" aria-label="Lieferung oder Abholung">
          <input type="radio" id="mode-menu-d" name="mode-menu" value="delivery" data-mode-input checked />
          <label for="mode-menu-d"><Icon name="scooter" />Lieferung</label>
          <input type="radio" id="mode-menu-p" name="mode-menu" value="pickup" data-mode-input />
          <label for="mode-menu-p"><Icon name="store" />Abholung</label>
        </div>
      )
    }
  </section>

  <div class="menu-bar" data-menu-bar>
    <div class="wrap menu-bar-inner">
      <form class="menu-search" role="search" onsubmit="return false">
        <label class="sr-only" for="menu-q">Speisekarte durchsuchen</label>
        <Icon name="search" class="ms-icon" />
        <input id="menu-q" type="search" placeholder="Suchen: Pizza, Döner, vegetarisch …" autocomplete="off" enterkeyhint="search" spellcheck="false" />
        <button type="button" class="ms-clear" data-search-clear hidden aria-label="Suche löschen"><Icon name="x" /></button>
      </form>
      <nav class="cat-nav" aria-label="Kategorien">
        <ul role="list" data-cat-nav>
          {
            cats.map((c) => (
              <li>
                <a href={`#${c.id}`} data-cat-link={c.id}>
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="wrap menu-layout">
    <div class="menu-col">
      <p class="search-status label" data-search-status aria-live="polite"></p>
      <div class="search-empty" data-search-empty hidden>
        <Icon name="search" />
        <p class="h4">Nichts gefunden für „<span data-search-term></span>“.</p>
        <p class="muted">Versuch’s mit „Pizza“, „Döner“, „vegetarisch“ oder einer Nummer von der Karte.</p>
        <button type="button" class="btn btn--dark btn--sm" data-search-clear>Suche zurücksetzen</button>
      </div>

      {
        cats.map((c) => (
          <section class="menu-cat" id={c.id} aria-labelledby={`h-${c.id}`} data-cat={c.id}>
            <header class="cat-head">
              <div class="cat-text">
                <h2 class="d2" id={`h-${c.id}`}>
                  {c.name}
                </h2>
                {c.intro && <p class="muted">{c.intro}</p>}
              </div>
              <p class="cat-count label">
                <span class="num">{c.products.length}</span> {c.products.length === 1 ? 'Gericht' : 'Gerichte'}
                {c.fromPrice !== null && (
                  <>
                    {' '}
                    · ab <span class="num">{formatEuro(c.fromPrice)}</span>
                  </>
                )}
              </p>
            </header>
            <div class="dish-list">
              {c.products.map((p) => (
                <Dish product={p} categoryName={c.name} />
              ))}
            </div>
          </section>
        ))
      }

      <aside class="menu-foot">
        <Icon name="info" />
        <p>
          Hochgestellte Kennzeichnungen (z. B. <span class="num">G · 2</span>) erklären wir unter <a href="/allergene/">Allergene &amp; Zusatzstoffe</a>. Bei Allergien
          frag bitte vor der Bestellung kurz telefonisch nach. Alle Preise in Euro inkl. MwSt.
        </p>
      </aside>
    </div>

    <aside class="cart-col" aria-labelledby="panel-title">
      <div class="cart-panel" data-cart-panel>
        <div class="sheet-head">
          <h2 class="d3" id="panel-title" tabindex="-1">Deine Bestellung</h2>
        </div>
        <div class="cart-view" data-cart-view></div>
      </div>
    </aside>
  </div>
</Base>

<script>
  import '../scripts/menu.ts';
</script>

<style>
  .menu-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-top: clamp(2rem, 1rem + 4vw, 4.5rem);
    padding-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .mh-text .label {
    color: var(--tomato-ink);
    margin-bottom: 0.9rem;
  }
  .mh-sub {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.25rem;
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .mh-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-weight: 600;
  }
  @media (max-width: 639px) {
    /* Platz für zweizeiligen Live-Status reservieren (kein Layout-Sprung) */
    .mh-status {
      min-height: 3.1em;
    }
  }
  .mh-mode {
    min-width: min(100%, 22rem);
  }

  /* Sticky-Leiste: Suche + Kategorien */
  .menu-bar {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: rgb(244 235 220 / 0.95);
    border-block: 1px solid var(--line);
  }
  @supports (backdrop-filter: blur(1px)) {
    .menu-bar {
      background: rgb(244 235 220 / 0.86);
      backdrop-filter: saturate(1.4) blur(14px);
    }
  }
  .menu-bar-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.6rem;
  }
  .menu-search {
    position: relative;
    flex: 0 0 auto;
    width: 2.9rem;
    transition: width var(--d-sheet) var(--ease-rise);
  }
  @media (min-width: 1024px) {
    .menu-search {
      width: 15rem;
    }
    .menu-search:not(:focus-within):not(.has-value) input::placeholder {
      color: var(--ink-3) !important;
    }
  }
  .menu-search:focus-within,
  .menu-search.has-value {
    width: min(100%, 22rem);
  }
  .menu-search :global(.ms-icon) {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    width: 1.2rem;
    height: 1.2rem;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .menu-search input {
    width: 100%;
    min-height: 2.9rem;
    padding: 0.5rem 2.6rem 0.5rem 2.6rem;
    border-radius: var(--r-round);
    border: 1.5px solid var(--line-strong);
    background: var(--paper);
    font-size: 1rem;
    -webkit-appearance: none;
    appearance: none;
  }
  .menu-search input::placeholder {
    color: var(--ink-3);
  }
  .menu-search input::-webkit-search-cancel-button {
    display: none;
  }
  .menu-search:not(:focus-within):not(.has-value) input::placeholder {
    color: transparent;
  }
  .menu-search input:focus-visible {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgb(28 21 17 / 0.14);
  }
  .ms-clear {
    position: absolute;
    right: 0.3rem;
    top: 50%;
    transform: translateY(-50%);
    width: 2.3rem;
    height: 2.3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  .ms-clear :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .cat-nav {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
    mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
  }
  .cat-nav::-webkit-scrollbar {
    display: none;
  }
  .cat-nav ul {
    display: flex;
    gap: 0.25rem;
    padding-right: 2.5rem;
  }
  /* Kategorien: nur Text, ruhig – aktiv als dunkle Pille */
  .cat-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.05rem;
    border-radius: var(--r-round);
    color: var(--ink-2);
    font-weight: 600;
    font-size: 1rem;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--d-hover) var(--ease-rise),
      color var(--d-hover) var(--ease-rise);
  }
  @media (hover: hover) {
    .cat-nav a:hover {
      color: var(--ink);
      background: rgb(28 21 17 / 0.06);
    }
  }
  .cat-nav a[aria-current='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .cat-nav a.is-empty {
    opacity: 0.35;
  }

  /* Layout */
  .menu-layout {
    display: grid;
    gap: 2.5rem;
    padding-bottom: var(--section);
  }
  .cart-col {
    display: none;
  }
  @media (min-width: 1200px) {
    .menu-layout {
      grid-template-columns: minmax(0, 1fr) 24rem;
      gap: 3.5rem;
      align-items: start;
    }
    .cart-col {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + var(--menubar-h, 4.2rem) + 1rem);
      padding-top: 2rem;
    }
    .cart-col :global(.cart-panel) {
      position: static;
      max-height: calc(100svh - var(--header-h) - var(--menubar-h, 4.2rem) - 3rem);
    }
  }
  .menu-cat {
    padding-top: clamp(3rem, 2rem + 3vw, 5rem);
    scroll-margin-top: calc(var(--header-h) + var(--menubar-h, 4.2rem) + 0.5rem);
  }
  /* Kategorie-Kopf: großer Titel, ruhige Unterzeile, Zahlen rechts */
  .cat-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    gap: 0.6rem 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .cat-text p {
    margin-top: 0.55rem;
    max-width: 52ch;
    font-size: 1.05rem;
    line-height: 1.5;
  }
  .cat-count {
    color: var(--ink-3);
  }
  @media (min-width: 640px) {
    .cat-head {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .cat-count {
      text-align: right;
      padding-bottom: 0.2rem;
    }
  }

  /* ---------- Gerichte als ruhige Karten (nur hier, nicht auf der Startseite) ---------- */
  .dish-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .menu-col :global(.dish) {
    gap: 0.6rem 2rem;
    padding: 1.4rem 1.6rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--paper);
    transition:
      border-color var(--d-hover) var(--ease-rise),
      box-shadow var(--d-ui) var(--ease-rise);
  }
  @media (hover: hover) {
    .menu-col :global(.dish:hover) {
      border-color: var(--line-strong);
      box-shadow: var(--shadow-1);
    }
  }
  .menu-col :global(.dish-title) {
    gap: 0.15rem 0.7rem;
  }
  .menu-col :global(.dish-nr) {
    min-width: 0;
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .menu-col :global(.dish-name) {
    font-size: clamp(1.3rem, 1.12rem + 0.5vw, 1.55rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .menu-col :global(.dish-desc) {
    margin-top: 0.4rem;
    max-width: 48ch;
    font-size: 1.02rem;
    line-height: 1.55;
  }
  .menu-col :global(.dish-meta) {
    gap: 0.35rem 1.1rem;
    margin-top: 0.7rem;
  }
  .menu-col :global(.dish-codes) {
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }
  .menu-col :global(.dish-extras) {
    min-height: 1.75rem;
    padding: 0;
    color: var(--tomato-ink);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration-color: transparent;
  }
  @media (hover: hover) {
    .menu-col :global(.dish-extras:hover) {
      text-decoration-color: currentColor;
    }
  }
  .menu-col :global(.dish-actions) {
    gap: 0.75rem;
  }
  .menu-col :global(.dish-price) {
    font-size: 1.15rem;
    font-weight: 700;
  }

  /* Ein Bedienelement für alles: Kontur-Plus, beim Überfahren tomatenrot,
     nach dem Hinzufügen grün mit Haken */
  .menu-col :global(.size-btn) {
    min-height: 3.25rem;
    column-gap: 0.85rem;
    padding: 0.4rem 0.45rem 0.4rem 1rem;
    border: 1px solid var(--line-strong);
    background: transparent;
  }
  .menu-col :global(.size-btn .sz) {
    font-size: 0.74rem;
  }
  .menu-col :global(.size-btn .pr) {
    font-size: 1.1rem;
  }
  .menu-col :global(.size-btn .plus) {
    width: 2.35rem;
    height: 2.35rem;
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .menu-col :global(.add) {
    --add-bg: transparent;
    --add-fg: var(--ink);
    width: 2.6rem;
    height: 2.6rem;
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .menu-col :global(.choose-btn) {
    --btn-bg: transparent;
    --btn-fg: var(--ink);
    --btn-bd: var(--ink);
  }
  @media (hover: hover) {
    .menu-col :global(.size-btn:hover) {
      border-color: var(--ink);
      background: #fff;
    }
    .menu-col :global(.size-btn:hover .plus) {
      background: var(--tomato);
      color: #fff;
      box-shadow: none;
    }
    .menu-col :global(.add:hover) {
      --add-bg: var(--tomato);
      --add-fg: #fff;
      box-shadow: none;
    }
    .menu-col :global(.choose-btn:hover) {
      --btn-bg: var(--ink);
      --btn-fg: var(--paper);
    }
  }
  .menu-col :global(.size-btn.is-added) {
    border-color: var(--herb);
  }
  .menu-col :global(.size-btn.is-added .plus),
  .menu-col :global(.add.is-added),
  .menu-col :global(.is-added .add) {
    --add-bg: var(--herb);
    --add-fg: #fff;
    background: var(--herb);
    color: #fff;
    box-shadow: none;
  }
  @media (max-width: 639px) {
    .menu-col :global(.dish) {
      padding: 1.15rem 1.2rem;
      border-radius: 16px;
    }
    .dish-list {
      gap: 0.6rem;
      margin-top: 1.1rem;
    }
  }
  .search-status:empty {
    display: none;
  }
  .search-status {
    padding-top: 1.5rem;
    color: var(--ink-2);
  }
  .search-empty {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    padding: 3rem 0 1rem;
  }
  .search-empty > :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ink-3);
  }
  .menu-foot {
    display: flex;
    gap: 0.75rem;
    margin-top: 3rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--r-m);
    background: var(--dough-2);
    font-size: 0.92rem;
  }
  .menu-foot :global(svg) {
    flex: none;
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.15rem;
  }
  .menu-foot a {
    color: var(--tomato-ink);
    font-weight: 650;
  }
  :global(.dish.is-hidden),
  .menu-cat.is-hidden {
    display: none;
  }
  /* zugeklappte Suche (Handy/Tablet): nur die Lupe, das Feld bleibt so schmal wie der Kreis */
  @media (max-width: 1023.98px) {
    .menu-search:not(:focus-within):not(.has-value) input {
      padding: 0;
      color: transparent;
    }
    .menu-search:not(:focus-within):not(.has-value) :global(.ms-icon) {
      left: 50%;
      transform: translate(-50%, -50%);
    }
  }
  @media (max-width: 639px) {
    .menu-bar-inner {
      flex-wrap: nowrap;
    }
    .menu-search:focus-within,
    .menu-search.has-value {
      width: 100%;
    }
    .menu-search:focus-within + .cat-nav,
    .menu-search.has-value + .cat-nav {
      display: none;
    }
    .cat-nav a {
      padding: 0 0.85rem 0 0.7rem;
    }
  }
</style>
