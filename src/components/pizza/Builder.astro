---
/**
 * „Erstelle deine eigene Pizza“ – Vollbild-Dialog. Alles Sichtbare kommt als
 * HTML vom Server (Größen, Zutaten, Preise); das Verhalten wird erst beim
 * Öffnen nachgeladen (src/scripts/pizza/builder.ts).
 */
import Icon from '../Icon.astro';
import { site } from '../../data/index.ts';
import { builderModel, HOLLANDAISE, HOLLANDAISE_NOTE, TOPPING_GROUP } from '../../lib/pizza-builder.ts';
import { choicePrice } from '../../lib/catalog.ts';
import { formatEuro } from '../../lib/pricing.ts';
import { serializeForScript } from '../../lib/client-data.ts';
import { look, tileCss, type Atlas } from '../../scripts/pizza/toppings.ts';
import atlasMeta from '../../../public/pizza/toppings.json';

const m = builderModel(site.catalog);
const DEFAULT = 'gross';
const atlas: Atlas = { ...(atlasMeta as Omit<Atlas, 'url' | 'count'>), url: '/pizza/toppings.webp', count: Object.keys(atlasMeta.rows).length };
const size0 = m?.sizes.find((v) => v.id === DEFAULT) ?? m?.sizes[0];
const priceOf = (id: string, v: string) => {
  const c = m?.group.choices.find((x) => x.id === id);
  return c ? (choicePrice(c, v) ?? 0) : 0;
};
const pricesOf = (id: string) => Object.fromEntries((m?.sizes ?? []).map((v) => [v.id, priceOf(id, v.id)]));
const priceText = (p: number) => (p > 0 ? `+${formatEuro(p)}` : 'inklusive');
const data = m && {
  base: { id: m.product.id, name: m.product.name },
  group: TOPPING_GROUP,
  max: m.group.max ?? 10,
  size: size0!.id,
  sizes: m.sizes.map((v) => ({ id: v.id, label: v.label, detail: v.detail ?? '', price: v.price })),
  choices: Object.fromEntries(m.group.choices.map((c) => [c.id, { label: c.label, prices: pricesOf(c.id), z: look(c.id).z }])),
  classics: m.classics,
  hollandaise: { id: HOLLANDAISE, note: HOLLANDAISE_NOTE },
  extraCheese: 'mit-extra-kaese',
};
let step = 1;
/** Ebenen des Bodens: wer sichtbar ist, steuert das Skript (Start: Tomatensauce + Käse) */
const LAYERS = [
  { key: 'crust', file: 'pb-crust', kind: 'crust', on: true },
  { key: 'crust-clean', file: 'pb-crust-clean', kind: 'crust', on: false },
  { key: 'sauce-tomato', file: 'pb-sauce-tomato', kind: 'sauce', on: true },
  { key: 'sauce-holl', file: 'pb-sauce-holl', kind: 'sauce', on: false },
  { key: 'cheese', file: 'pb-cheese', kind: 'cheese', on: true },
  { key: 'cheese-holl', file: 'pb-cheese-holl', kind: 'cheese', on: false },
];
/** Sauce und Käse: von Anfang an wählbar. Weglassen kostet nichts extra und
 *  spart nichts (Grundlage bleibt die Margherita) – geht als Hinweis an die Küche */
const CHOICES: Record<string, { value: string; name: string; note: string; ing?: string; price?: string }[]> = {
  sauce: [
    { value: 'tomato', name: 'Tomatensauce', note: 'Standard', price: 'inklusive' },
    { value: 'holl', name: 'Sauce Hollandaise', note: 'statt Tomatensauce', ing: HOLLANDAISE },
    { value: 'none', name: 'Ohne Sauce', note: 'Preis bleibt gleich', price: '±0,00 €' },
  ],
  kaese: [
    { value: 'on', name: 'Mit Käse', note: 'Standard', price: 'inklusive' },
    { value: 'off', name: 'Ohne Käse', note: 'Preis bleibt gleich', price: '±0,00 €' },
  ],
};
---

{
  m && size0 && (
    <dialog class="pb" id="pizza-builder" aria-labelledby="pb-title" data-pb>
      <script type="application/json" id="pb-data" set:html={serializeForScript(data)} />
      <div class="pb-shell">
        <header class="pb-top">
          <div class="pb-top-text">
            <p class="label pb-kicker">Erstelle deine eigene Pizza</p>
            <h2 class="pb-title" id="pb-title">
              Deine Pizza
            </h2>
          </div>
          <button type="button" class="pb-close" data-close aria-label="Pizza-Ersteller schließen">
            <span class="pb-close-x" aria-hidden="true"><Icon name="x" /></span>
            <span class="pb-close-t">Schließen</span>
          </button>
        </header>

        <div class="pb-main" data-pb-scroll>
          <section class="pb-stage" aria-label="Vorschau deiner Pizza">
            <div class="pb-plate" data-pb-plate>
              <div class="pb-pizza" data-pb-pizza style={`--sz:${size0.id === 'klein' ? 0.86 : 1}`}>
                {/* Boden aus Ebenen derselben Pizza (scripts/pizza-builder/build-layers.py):
                    Teig, Sauce (Tomate oder Hollandaise), Käse – Sauce und Käse sind wählbar */}
                {LAYERS.map((l) => (
                  <img
                    class:list={['pb-base', `pb-${l.kind}`, { 'is-on': l.on }]}
                    src={`/pizza/${l.file}-640.webp`}
                    srcset={`/pizza/${l.file}-640.webp 640w, /pizza/${l.file}-1024.webp 1024w`}
                    sizes="(min-width: 1024px) 560px, 70vw"
                    width="640"
                    height="640"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    data-pb-layer={l.key}
                  />
                ))}
                <div class="pb-tops" data-pb-tops />
                <span class="pb-light" aria-hidden="true" />
              </div>
              <span class="pb-drop" aria-hidden="true" />
            </div>
            <p class="pb-hint" data-pb-hint>
              <span class="pb-hint-touch">Zutat antippen – sie landet sofort auf der Pizza.</span>
              <span class="pb-hint-mouse">Zutat anklicken oder direkt auf die Pizza ziehen.</span>
            </p>
          </section>

          <div class="pb-panel">
            <nav class="pb-jump" aria-label="Bereiche">
              <a href="#pb-s-size">Größe</a>
              {m.sections.map((s) => (
                <a href={`#pb-s-${s.id}`}>{s.title}</a>
              ))}
            </nav>

            <section class="pb-sec" id="pb-s-size" aria-labelledby="pb-h-size">
              <h3 class="pb-h" id="pb-h-size">
                <span class="pb-step">{step++}</span> Größe
              </h3>
              <div class="pb-sizes" role="radiogroup" aria-labelledby="pb-h-size">
                {m.sizes.map((v) => (
                  <label class="pb-size">
                    <input type="radio" name="pb-size" value={v.id} checked={v.id === size0.id} data-pb-size />
                    <span class="pb-size-name">{v.label}</span>
                    <span class="pb-size-detail">{v.detail}</span>
                    <span class="pb-size-price num">{formatEuro(v.price)}</span>
                  </label>
                ))}
              </div>
            </section>

            {m.sections.map((s) => (
              <section class="pb-sec" id={`pb-s-${s.id}`} aria-labelledby={`pb-h-${s.id}`}>
                <h3 class="pb-h" id={`pb-h-${s.id}`}>
                  <span class="pb-step">{step++}</span> {s.title}
                </h3>
                {CHOICES[s.id] && (
                  <div class="pb-opts" role="radiogroup" aria-labelledby={`pb-h-${s.id}`}>
                    {CHOICES[s.id].map((o, i) => (
                      <label class:list={['pb-opt', `pb-opt--${o.value}`]}>
                        <input type="radio" name={`pb-${s.id}`} value={o.value} checked={i === 0} data-pb-base-choice={s.id} />
                        <span class="pb-opt-pic" aria-hidden="true" />
                        <span class="pb-opt-name">{o.name}</span>
                        <span class="pb-opt-note">{o.note}</span>
                        <span class="pb-opt-price num" data-pb-opt-price={o.ing}>
                          {o.ing ? priceText(priceOf(o.ing, size0.id)) : o.price}
                        </span>
                      </label>
                    ))}
                  </div>
                )}
                {s.parts.map((p) => (
                  <>
                    {CHOICES[s.id] && p.items.some((c) => c.id !== HOLLANDAISE) && <h4 class="pb-sub">Dazu</h4>}
                    {p.sub && <h4 class="pb-sub">{p.sub}</h4>}
                    <ul class="pb-list" role="list">
                      {p.items.filter((c) => c.id !== HOLLANDAISE).map((c) => (
                        <li>
                          <button type="button" class="pb-ing" data-ing={c.id} aria-pressed="false">
                            <span class="pb-pic" data-cover={look(c.id).cover ? c.id : undefined}>
                              {!look(c.id).cover && <span class="pb-pic-in" style={tileCss(atlas, c.id, 0)} />}
                            </span>
                            <span class="pb-name">{c.label}</span>
                            <span class="pb-price num" data-pb-price>
                              {priceText(priceOf(c.id, size0.id))}
                            </span>
                            <span class="pb-act" aria-hidden="true">
                              <span class="pb-act-add">
                                <Icon name="plus" />
                                Hinzufügen
                              </span>
                              <span class="pb-act-rm">
                                <Icon name="minus" />
                                Entfernen
                              </span>
                            </span>
                          </button>
                        </li>
                      ))}
                    </ul>
                  </>
                ))}
              </section>
            ))}
          </div>

          <aside class="pb-sum" aria-labelledby="pb-sum-title">
            <div class="pb-sum-head">
              <h3 class="pb-sum-title" id="pb-sum-title">
                Deine Pizza
              </h3>
              <p class="pb-count" data-pb-count>
                0 von {m.group.max ?? 10} Extras
              </p>
            </div>
            <ul class="pb-lines" role="list" data-pb-lines>
              <li class="pb-line pb-line--base">
                <span>
                  {m.product.name} · <span data-pb-size-label>{size0.label} {size0.detail}</span>
                </span>
                <span class="num" data-pb-base-price>
                  {formatEuro(size0.price)}
                </span>
              </li>
            </ul>
            <p class="pb-tip" data-pb-tip hidden />
            <div class="pb-total">
              <span>Gesamt</span>
              <output class="pb-total-val num" data-pb-total>
                <span>{formatEuro(size0.price)}</span>
              </output>
            </div>
            <div class="pb-actions">
              <button type="button" class="btn btn--primary btn--lg btn--block pb-add" data-pb-add>
                <Icon name="bag" /> In den Warenkorb
              </button>
              <div class="pb-minor">
                <button type="button" class="link-btn" data-pb-last disabled>
                  Letzte Zutat entfernen
                </button>
                <button type="button" class="link-btn" data-pb-reset disabled>
                  Zurücksetzen
                </button>
              </div>
            </div>
            <p
              class="pb-fine"
              data-pb-fine
              data-std={`Bestellt wird eine ${m.product.name} (${m.product.description}) mit deinen Extras.`}
              data-custom={`Bestellt wird eine ${m.product.name} mit deinen Extras – deine Wünsche zu Sauce und Käse stehen als Hinweis für die Küche dabei. Weglassen ändert den Preis nicht.`}
            >
              Bestellt wird eine {m.product.name} ({m.product.description}) mit deinen Extras.
            </p>
          </aside>
        </div>

        <div class="pb-bar">
          <p class="pb-bar-text">
            <span class="pb-bar-label">Deine Pizza</span>
            <output class="pb-bar-total num" data-pb-total-bar>
              {formatEuro(size0.price)}
            </output>
          </p>
          <button type="button" class="btn btn--primary pb-add" data-pb-add>
            <Icon name="bag" /> In den Warenkorb
          </button>
        </div>

        <div class="pb-note" data-pb-note role="status" hidden>
          <span data-pb-note-text />
          <button type="button" data-pb-undo>
            Rückgängig
          </button>
        </div>
      </div>
    </dialog>
  )
}

<style>
  /* ---------- Rahmen ---------- */
  dialog.pb {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background: var(--dough);
    color: var(--ink);
    overflow: hidden;
    overscroll-behavior: contain;
  }
  dialog.pb:not([open]) {
    display: none;
  }
  dialog.pb::backdrop {
    background: rgb(14 9 6 / 0.55);
  }
  .pb-shell {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100%;
  }
  .pb-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem var(--gutter);
    border-bottom: 1px solid var(--line);
    background: var(--dough);
    z-index: 3;
  }
  .pb-kicker {
    color: var(--tomato-ink);
  }
  .pb-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.8rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  /* Schließen: kräftig und klar – dunkler Knopf, das Kreuz dreht sich beim Zeigen */
  .pb-close {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.35rem 1.15rem 0.35rem 0.35rem;
    border-radius: var(--r-round);
    background: var(--ink);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    box-shadow: 0 8px 20px -10px rgb(28 21 17 / 0.6);
    transition:
      background-color var(--d-hover),
      transform 200ms var(--ease-rise),
      box-shadow var(--d-hover);
  }
  .pb-close-x {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    transition:
      transform 320ms var(--ease-settle),
      background-color var(--d-hover);
  }
  .pb-close :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    stroke-width: 2.4;
  }
  @media (hover: hover) {
    .pb-close:hover {
      background: var(--tomato);
      box-shadow: 0 10px 24px -10px rgb(200 54 27 / 0.7);
    }
    .pb-close:hover .pb-close-x {
      transform: rotate(90deg);
      background: rgb(255 255 255 / 0.22);
    }
  }
  .pb-close:active {
    transform: scale(0.96);
  }
  .pb-close:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  /* Handy: nur das Kreuz, groß genug für den Daumen */
  @media (max-width: 479px) {
    .pb-close {
      padding: 0.35rem;
    }
    .pb-close-t {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  /* ---------- Aufteilung ---------- */
  .pb-main {
    display: grid;
    grid-template-areas: 'stage' 'panel' 'sum';
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .pb-stage {
    grid-area: stage;
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: clamp(230px, 40svh, 360px);
    padding: 0.75rem var(--gutter) 0.5rem;
    background: var(--dough);
    box-shadow: 0 8px 16px -12px rgb(28 21 17 / 0.25);
    /* die Pizza richtet sich nach dem Platz, den sie hat */
    container-type: size;
  }
  .pb-panel {
    grid-area: panel;
    padding: 0.5rem var(--gutter) 1.5rem;
  }
  .pb-sum {
    grid-area: sum;
    margin: 0 var(--gutter) 1.5rem;
    padding: 1.25rem 1.3rem;
    border-radius: 20px;
    background: var(--paper);
    border: 1px solid var(--line);
  }
  @media (min-width: 1024px) {
    .pb-sum {
      padding: 1rem 1.2rem;
    }
    .pb-fine {
      display: none;
    }
    .pb-main {
      grid-template-areas: 'stage panel' 'sum panel';
      grid-template-columns: minmax(0, 1.1fr) minmax(24rem, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
      overflow: hidden;
    }
    .pb-stage {
      position: relative;
      height: auto;
      min-height: 0;
      padding: 1.25rem 2rem 0.5rem var(--gutter);
      background: none;
      box-shadow: none;
    }
    .pb-panel {
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 1.25rem var(--gutter) 3rem 2rem;
      border-left: 1px solid var(--line);
      background: var(--paper);
    }
    .pb-sum {
      margin: 0 2rem 1.5rem var(--gutter);
    }
  }

  /* ---------- Pizza ---------- */
  .pb-plate {
    position: relative;
    flex: none;
    width: min(100cqw, calc(100cqh - 2.4rem), 600px);
    aspect-ratio: 1;
  }
  .pb-pizza {
    position: absolute;
    inset: 0;
    transform: scale(var(--sz, 1));
    transition:
      transform 520ms var(--ease-settle),
      opacity 320ms var(--ease-rise);
  }
  /* bis der Boden geladen ist (Skript setzt is-ready): kein leerer Umriss */
  :global(html.js) .pb-pizza:not(:global(.is-ready)) {
    opacity: 0;
  }
  .pb-base {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 14px 22px rgb(60 30 4 / 0.28));
  }
  /* Ebenen: nur die Teig-Ebene wirft den Schatten; ausgeblendete Ebenen sind
     unsichtbar (Sauce: von der Mitte verstrichen, Käse: aufgestreut – Skript) */
  .pb-base:not(.pb-crust) {
    filter: none;
  }
  .pb-base:not(:global(.is-on)) {
    opacity: 0;
  }
  .pb-tops {
    position: absolute;
    inset: 0;
  }
  .pb-tops :global(.pb-pc) {
    position: absolute;
    display: block;
    aspect-ratio: 1;
    background-repeat: no-repeat;
    pointer-events: none;
  }
  .pb-tops :global(img.pb-pc) {
    aspect-ratio: auto;
  }
  /* ein Licht für Boden und Belag: Zutaten wirken wie mitfotografiert */
  .pb-light {
    position: absolute;
    inset: 0;
    z-index: 900;
    pointer-events: none;
    /* genau auf die Pizza begrenzt (Form aus dem Bild selbst) */
    -webkit-mask: url(/pizza/base-320.webp) center / 100% 100% no-repeat;
    mask: url(/pizza/base-320.webp) center / 100% 100% no-repeat;
    background:
      radial-gradient(65% 55% at 34% 28%, rgb(255 246 225 / 0.32), transparent 62%),
      radial-gradient(closest-side, transparent 66%, rgb(70 28 6 / 0.3));
    mix-blend-mode: soft-light;
  }
  /* Ablegen: feiner Lichtring statt großer Zone */
  .pb-drop {
    position: absolute;
    inset: 1%;
    border-radius: 50%;
    box-shadow:
      0 0 0 2px rgb(242 181 58 / 0.9),
      0 0 40px rgb(242 181 58 / 0.45);
    opacity: 0;
    transform: scale(0.97);
    transition:
      opacity var(--d-ui) var(--ease-rise),
      transform var(--d-ui) var(--ease-rise);
    pointer-events: none;
  }
  .pb-plate.is-target .pb-drop {
    opacity: 0.35;
    transform: none;
  }
  .pb-plate.is-over .pb-drop {
    opacity: 1;
    transform: scale(1.01);
  }
  .pb-hint {
    font-size: 0.88rem;
    color: var(--ink-2);
    text-align: center;
  }
  .pb-hint-mouse {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .pb-hint-touch {
      display: none;
    }
    .pb-hint-mouse {
      display: inline;
    }
  }

  /* ---------- Bereiche ---------- */
  .pb-jump {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    gap: 0.4rem;
    margin: 0 calc(-1 * var(--gutter)) 0.25rem;
    padding: 0.6rem var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--dough);
  }
  .pb-jump a {
    flex: none;
    padding: 0.45rem 0.95rem;
    border-radius: var(--r-round);
    border: 1px solid var(--line-strong);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    white-space: nowrap;
  }
  @media (hover: hover) {
    .pb-jump a:hover {
      border-color: var(--ink);
    }
  }
  @media (min-width: 1024px) {
    .pb-jump {
      top: -1.25rem;
      margin: -1.25rem calc(-1 * var(--gutter)) 0.25rem -2rem;
      padding: 1rem var(--gutter) 0.75rem 2rem;
      background: var(--paper);
    }
  }
  /* mobil liegt die Pizza oben – die Leiste darunter kleben lassen */
  @media (max-width: 1023px) {
    .pb-jump {
      top: clamp(230px, 40svh, 360px);
    }
  }
  .pb-sec {
    padding-top: 1.4rem;
    scroll-margin-top: 4rem;
  }
  @media (max-width: 1023px) {
    .pb-sec {
      scroll-margin-top: calc(clamp(230px, 40svh, 360px) + 3.5rem);
    }
  }
  .pb-h {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.015em;
  }
  .pb-step {
    display: inline-grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .pb-sub {
    margin: 1rem 0 0.5rem;
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: var(--fs-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* Größe */
  .pb-sizes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .pb-size {
    position: relative;
    display: grid;
    gap: 0.1rem;
    padding: 0.9rem 1rem;
    border-radius: 16px;
    border: 1.5px solid var(--line-strong);
    background: var(--paper);
    cursor: pointer;
    transition:
      border-color var(--d-hover),
      background-color var(--d-hover),
      box-shadow var(--d-hover);
  }
  .pb-size input {
    position: absolute;
