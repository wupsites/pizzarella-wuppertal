---
/** „Lange wach.“ – die Öffnungszeiten als Wochen-Zeitleiste mit Live-Markierung „jetzt“. */
import { site } from '../../data/index.ts';
import { closingSentence, timelineBars, TIMELINE_START, TIMELINE_END } from '../../lib/hours.ts';

const { hours } = site.business;
const rows = timelineBars(hours);
const span = TIMELINE_END - TIMELINE_START;
const ticks = [12, 14, 16, 18, 20, 22, 24, 26].map((h) => ({
  label: h === 24 ? '0' : String(h % 24),
  left: (((h * 60 - TIMELINE_START) / span) * 100).toFixed(2),
  midnight: h === 24,
}));
const sentence = closingSentence(hours);
---

<section class="section late on-night grain" aria-labelledby="late-title">
  <div class="wrap late-grid">
    <div class="late-text">
      <p class="label">Öffnungszeiten</p>
      <h2 class="d1" id="late-title">Lange <span class="it">wach.</span></h2>
      <p class="lead">{sentence}</p>
      <p class="late-status"><span class="dot" aria-hidden="true"></span><span data-status-line></span></p>
    </div>

    <figure class="timeline reveal" aria-labelledby="tl-cap" data-timeline data-start={TIMELINE_START} data-end={TIMELINE_END}>
      <figcaption id="tl-cap" class="sr-only">Öffnungszeiten je Wochentag: {sentence}</figcaption>
      <div class="tl-body" aria-hidden="true">
        <div class="tl-ticks">
          {
            ticks.map((t) => (
              <span class:list={['tl-tick', { 'is-midnight': t.midnight }]} style={`left:${t.left}%`}>
                {t.label}
              </span>
            ))
          }
        </div>
        {
          rows.map((r, i) => (
            <div class="tl-row" data-weekday={r.weekday}>
              <span class="tl-day">{r.short}</span>
              <div class="tl-track">
                {r.bars.length ? (
                  r.bars.map((b) => (
                    <span class="tl-bar" style={`left:${b.left.toFixed(2)}%;width:${b.width.toFixed(2)}%;--i:${i}`}>
                      <span class="tl-time">
                        {b.open}–{b.close}
                      </span>
                    </span>
                  ))
                ) : (
                  <span class="tl-rest">Ruhetag</span>
                )}
              </div>
            </div>
          ))
        }
        <span class="tl-now" data-tl-now hidden><span>jetzt</span></span>
      </div>
    </figure>
  </div>
</section>

<style>
  .late-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .late-grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4.5rem;
    }
  }
  .late-text .label {
    color: var(--cheese);
    margin-bottom: 1rem;
  }
  .late-text .it {
    color: var(--cheese);
  }
  .late-text .lead {
    margin-top: 1.5rem;
    color: var(--cream-2);
  }
  .late-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    font-weight: 650;
  }
  .timeline {
    --day-w: 2.6rem;
  }
  .tl-body {
    position: relative;
    padding-top: 1.8rem;
  }
  .tl-ticks {
    position: absolute;
    top: 0;
    left: var(--day-w);
    right: 0;
    height: 100%;
  }
  .tl-tick {
    position: absolute;
    top: 0;
    bottom: 0;
    transform: translateX(-50%);
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--cream-2);
    font-variant-numeric: tabular-nums;
  }
  .tl-tick::after {
    content: '';
    position: absolute;
    top: 1.4rem;
    bottom: 0;
    left: 50%;
    border-left: 1px dashed rgb(244 235 220 / 0.12);
  }
  .tl-tick.is-midnight {
    color: var(--cheese);
  }
  .tl-tick.is-midnight::after {
    border-left: 1.5px solid rgb(242 181 58 / 0.55);
  }
  .tl-row {
    position: relative;
    display: flex;
    align-items: center;
    height: 3.1rem;
  }
  .tl-day {
    width: var(--day-w);
    flex: none;
    font-weight: 700;
    color: var(--cream-2);
  }
  .tl-row.is-today .tl-day {
    color: var(--cheese);
  }
  .tl-track {
    position: relative;
    flex: 1;
    height: 2.2rem;
    border-radius: var(--r-round);
    background: rgb(244 235 220 / 0.05);
  }
  .tl-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 0.8rem;
    border-radius: var(--r-round);
    background: linear-gradient(90deg, #c9822f, #f2b53a 55%, #ffcf6e);
    transform-origin: left;
  }
  .tl-row.is-today .tl-bar {
    box-shadow:
      0 0 0 2px var(--cream),
      0 0 24px rgb(255 150 60 / 0.45);
  }
  .tl-time {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 0.78rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tl-rest {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-left: 1rem;
    border: 1.5px dashed rgb(244 235 220 / 0.22);
    border-radius: var(--r-round);
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cream-2);
  }
  .tl-now {
    position: absolute;
    top: 1.5rem;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    background: var(--ember);
    box-shadow: 0 0 12px var(--ember);
  }
  .tl-now span {
    position: absolute;
    top: -1.55rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.05rem 0.45rem;
    border-radius: var(--r-round);
    background: var(--ember);
    color: var(--ink);
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .timeline.reveal {
      opacity: 1;
      transform: none;
    }
    .js .timeline .tl-bar {
      transform: scaleX(0);
      transition: transform 1.1s var(--ease-rise);
      transition-delay: calc(var(--i) * 80ms + 150ms);
    }
    .js .timeline.is-in .tl-bar {
      transform: scaleX(1);
    }
  }
  @media (max-width: 639px) {
    .timeline {
      --day-w: 2.1rem;
    }
    .tl-time {
      display: none;
    }
    .tl-row {
      height: 2.6rem;
    }
    .tl-track {
      height: 1.7rem;
    }
  }
</style>
