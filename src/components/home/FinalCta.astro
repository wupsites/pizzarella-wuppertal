---
import Icon from '../Icon.astro';
import { site } from '../../data/index.ts';
const { business } = site;
---

<section class="final grain" aria-labelledby="final-title">
  <div class="wrap final-inner">
    <h2 class="final-title" id="final-title">Hunger?</h2>
    <div class="final-side">
      <p class="final-status"><span class="dot" aria-hidden="true"></span><span data-status-line></span></p>
      <div class="final-actions">
        <a class="btn btn--light btn--lg" href="/speisekarte/">Zur Speisekarte <Icon name="arrow" class="btn-arrow" /></a>
        <a class="btn btn--ghost btn--lg final-phone" href={`tel:${business.phone.e164}`}><Icon name="phone" /> {business.phone.display}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .final {
    background: var(--tomato);
    color: #fff;
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem);
    overflow: hidden;
  }
  .final.grain::after {
    mix-blend-mode: multiply;
    opacity: 0.12;
  }
  .final-inner {
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  @media (min-width: 900px) {
    .final-inner {
      grid-template-columns: 1fr auto;
    }
  }
  .final-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(4.5rem, 2rem + 13vw, 13rem);
    line-height: 0.82;
    letter-spacing: -0.045em;
  }
  .final-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 650;
    font-size: 1.05rem;
  }
  .final-status :global(.dot) {
    background: #fff;
  }
  .final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .final .btn--light {
    --btn-fg: var(--tomato-ink);
  }
  .final-phone {
    --btn-fg: #fff;
    --btn-bd: rgb(255 255 255 / 0.5);
  }
  @media (hover: hover) {
    .final-phone:hover {
      --btn-bd: #fff;
    }
  }
  .final :focus-visible {
    outline-color: #fff;
  }
</style>
