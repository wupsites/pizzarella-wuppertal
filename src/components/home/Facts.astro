---
/** „Kurz gesagt“ – harte Fakten statt Floskeln, alles aus den Daten berechnet. */
import { site } from '../../data/index.ts';
import Icon from '../Icon.astro';
import { formatEuro, formatPrice } from '../../lib/pricing.ts';

const { catalog, zones, home, business } = site;
const pizza = catalog.categories.find((c) => c.id === 'pizza');
const pizzaCount = pizza?.products.length ?? 0;
const latest = Object.values(business.hours.weekly)
  .flat()
  .map(([, close]) => close)
  .sort((a, b) => {
    const v = (t: string) => {
      const [h, m] = t.split(':').map(Number);
      const n = h * 60 + m;
      return n < 720 ? n + 1440 : n;
    };
    return v(b) - v(a);
  })[0];
const feeFree = zones.length > 0 && zones.every((z) => z.fee === 0);
const zipCount = zones.reduce((n, z) => n + z.zips.length, 0);
const facts = [
  { value: String(pizzaCount), label: 'Pizzen & Calzone', sub: 'klein Ø 25 oder groß Ø 30 cm' },
  { value: pizza?.fromPrice ? formatPrice(pizza.fromPrice) : '', unit: '€', label: 'Pizza ab', sub: 'Margherita, klein' },
  { value: latest, label: 'Fr & Sa geöffnet bis', sub: 'sonst bis 01:00 bzw. 24:00' },
  ...(feeFree ? [{ value: '0', unit: '€', label: 'Liefergebühr', sub: `${zipCount} Postleitzahlen in Wuppertal` }] : []),
];
const dp = home.directPrice;
// „Pizza Margherita groß: 7,90 € statt 9,90 €“ → Gericht, Preis hier, Preis dort.
// Passt das Beispiel nicht in dieses Muster, steht es einfach als Text da.
const toCents = (s: string) => Math.round(Number(s.replace(/\./g, '').replace(',', '.')) * 100);
const m = dp?.example?.match(/^(.+?):\s*([\d.,]+)\s*€\s*statt\s*([\d.,]+)\s*€\s*$/);
const cmp = m ? { item: m[1], ours: toCents(m[2]), theirs: toCents(m[3]) } : null;
const checked = dp ? new Date(dp.checked).toLocaleDateString('de-DE') : '';
---

<section class="section facts" aria-labelledby="facts-title">
  <div class="wrap">
    <h2 class="label facts-title" id="facts-title">Kurz gesagt</h2>
    {
      dp?.enabled && (
        <aside class="deal reveal" aria-labelledby="deal-title">
          <div class="deal-copy">
            <p class="deal-kicker">
              <Icon name="info" />
              Preisvorteil
            </p>
            <h3 class="deal-title" id="deal-title">
              Direkt bestellen <span class="deal-em">lohnt sich.</span>
            </h3>
            <p class="deal-text">{dp.text}</p>
            <a class="btn btn--dark deal-cta" href="/speisekarte/">
              Direkt bestellen <Icon name="arrow" class="btn-arrow" />
            </a>
          </div>
          {cmp ? (
            <div class="deal-cmp">
              <p class="deal-item">
                <span class="deal-cap">Beispiel</span>
                {cmp.item}
              </p>
              <div class="deal-prices">
                <p class="deal-ours">
                  <span class="deal-cap">Hier direkt</span>
                  <span class="deal-num num">{formatEuro(cmp.ours)}</span>
                </p>
                <p class="deal-theirs">
                  <span class="deal-cap">Bei Lieferando</span>
                  <span class="deal-was num">{formatEuro(cmp.theirs)}</span>
                </p>
              </div>
              {cmp.theirs > cmp.ours && (
                <p class="deal-save">
                  <span class="num">{formatEuro(cmp.theirs - cmp.ours)}</span> günstiger
                </p>
              )}
              <p class="deal-date">Preise verglichen am {checked}</p>
            </div>
          ) : (
            <div class="deal-cmp">
              {dp.example && <p class="deal-item">Beispiel: {dp.example}</p>}
              <p class="deal-date">Stand: {checked}</p>
            </div>
          )}
        </aside>
      )
    }
    <dl class="facts-grid">
      {
        facts.map((f, i) => (
          <div class="fact reveal" style={`--i:${i}`}>
            <dt class="fact-label">{f.label}</dt>
            <dd class="fact-value num">
              {f.value}
              {f.unit && <span class="fact-unit">{f.unit}</span>}
            </dd>
            <dd class="fact-sub muted">{f.sub}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .facts-title {
    color: var(--tomato-ink);
    margin-bottom: 2rem;
  }
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 2px solid var(--ink);
  }
  @media (min-width: 900px) {
    .facts-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .fact {
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.25rem 1.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  .fact + .fact {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }
  @media (max-width: 899px) {
    /* gleiche Spezifität wie „.fact + .fact“, sonst gewinnt das (Astro hängt
       an jeden Teil ein Attribut) */
    .fact + .fact:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
  }
  .fact-label {
    order: 1;
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: var(--fs-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .fact-value {
    order: 2;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(2.8rem, 1.6rem + 4vw, 5.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .fact-unit {
    font-size: 0.5em;
    margin-left: 0.08em;
    vertical-align: 0.65em;
  }
  .fact-sub {
    order: 3;
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
  /* ---------- Preisvorteil: die wichtigste Info des Abschnitts ---------- */
  .deal {
    position: relative;
    display: grid;
    gap: 2rem 3rem;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding: clamp(1.6rem, 1rem + 2.4vw, 3rem);
    border-radius: var(--r-l);
    background:
      radial-gradient(90% 120% at 100% 0%, rgb(255 236 190 / 0.75), transparent 60%),
      var(--cheese);
    color: var(--ink);
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .deal {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .deal-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem 0.35rem 0.6rem;
    border-radius: var(--r-round);
    background: var(--ink);
    color: var(--cheese-soft);
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: var(--fs-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .deal-kicker :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .deal-title {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(2.2rem, 1.3rem + 3.2vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .deal-em {
    font-style: italic;
    color: var(--tomato-ink);
  }
  .deal-text {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    font-weight: 500;
  }
  .deal-cta {
    margin-top: 1.6rem;
  }
  .deal-cmp {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.25rem, 0.9rem + 1.2vw, 2rem);
    border-radius: 20px;
    background: var(--paper);
    box-shadow: 0 1px 0 rgb(28 21 17 / 0.06), 0 18px 40px rgb(120 70 0 / 0.16);
  }
  .deal-cap {
    display: block;
    margin-bottom: 0.3rem;
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: var(--fs-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .deal-item {
    font-weight: 650;
    font-size: 1.15rem;
  }
  .deal-prices {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: start;
    align-items: end;
    gap: 0.5rem clamp(1.5rem, 1rem + 2vw, 3rem);
    padding: 1.1rem 0;
    border-block: 1px solid var(--line);
  }
  .deal-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(2.6rem, 1.6rem + 3.4vw, 4.4rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--herb);
  }
  .deal-was {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.2rem);
    line-height: 1;
    color: var(--ink-3);
  }
  /* Durchstreichen als eigener Strich: zieht sich beim Erscheinen durch */
  .deal-was::after {
    content: '';
    position: absolute;
    left: -6%;
    right: -6%;
    top: 50%;
    height: 0.09em;
    margin-top: -0.045em;
    border-radius: 2px;
    background: var(--tomato);
    transform: rotate(-9deg);
    transform-origin: left center;
  }
  .deal-save {
    justify-self: start;
    padding: 0.45rem 0.95rem;
    border-radius: var(--r-round);
    background: var(--herb);
    color: #fff;
    font-weight: 700;
    font-size: 1.02rem;
  }
  .deal-date {
    color: var(--ink-3);
    font-size: 0.88rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .deal .deal-was::after {
      transform: rotate(-9deg) scaleX(0);
      transition: transform 520ms var(--ease-rise) 650ms;
    }
    .js .deal.is-in .deal-was::after {
      transform: rotate(-9deg) scaleX(1);
    }
    .js .deal .deal-save {
      opacity: 0;
      transform: translateY(8px) scale(0.94);
      transition:
        opacity var(--d-ui) var(--ease-rise) 1000ms,
        transform var(--d-sheet) var(--ease-settle) 1000ms;
    }
    .js .deal.is-in .deal-save {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 479px) {
    .deal-prices {
      gap: 0.5rem 1.25rem;
    }
  }
</style>
