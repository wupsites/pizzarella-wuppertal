# Vorlage für wupsites-demo/.env (die echte .env wird nie eingecheckt).
# Keine geheimen Werte in dieser Datei.

# Adresse der Demo, z. B. eine Subdomain der WupSites-Domain. Muss per DNS auf den Server zeigen.
DEMO_DOMAIN=

# Zugang für Morad und Kund:innen in der Präsentation
DEMO_USER=
# bcrypt-Hash des Passworts, erzeugen mit:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'DEIN-PASSWORT'
# Wichtig: in einfache Anführungszeichen setzen, der Hash enthält $-Zeichen.
DEMO_PASSWORD_HASH=''

# Nur wenn das Portal die Demo im iframe zeigen soll: Ursprung des Portals, z. B. https://portal.<eure-domain>
# Leer lassen = Einbetten verboten (empfohlen: Präsentation im eigenen Fenster).
PORTAL_ORIGIN=

# ── Website selbst ─────────────────────────────────────────────────────
# In der Demo bewusst NICHT setzen (sonst gingen Bestellungen an den echten Laden):
#   SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS,
#   ORDER_MAIL_FROM, ORDER_MAIL_TO, ORDER_MAIL_CUSTOMER_COPY,
#   ORDER_WEBHOOK_URL, ORDER_WEBHOOK_SECRET
# SITE_URL ebenfalls nicht setzen: dann ist die gebaute Seite identisch mit dem Original.
